<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ============================================
         TYPOGRAPHY STYLES (Material 3)
         ============================================ -->

    <!-- Headline Large: App name, page titles (Home, Explore, Leaderboard) -->
    <style name="TextAppearance.TungTung.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/ttColorTextPrimary</item>
    </style>

    <!-- Headline Medium: Greeting text, profile name, section titles -->
    <style name="TextAppearance.TungTung.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/ttColorTextPrimary</item>
    </style>

    <!-- Title Large: Card titles, lesson title, section headers -->
    <style name="TextAppearance.TungTung.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/ttColorTextPrimary</item>
    </style>

    <!-- Title Medium: Feedback title, stat labels -->
    <style name="TextAppearance.TungTung.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/ttColorTextPrimary</item>
    </style>

    <!-- Body Large: Onboarding description, category title -->
    <style name="TextAppearance.TungTung.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/ttColorTextPrimary</item>
    </style>

    <!-- Body Medium: Subtitle, description texts, normal content -->
    <style name="TextAppearance.TungTung.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/ttColorTextPrimary</item>
    </style>

    <!-- Body Small: Secondary info, progress text, media summary -->
    <style name="TextAppearance.TungTung.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?attr/ttColorTextSecondary</item>
    </style>

    <!-- Label Small: Badge text, labels, meta info -->
    <style name="TextAppearance.TungTung.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/ttColorTextSecondary</item>
    </style>

    <!-- Display Small: Stat numbers (Today, Week, Best streak) -->
    <style name="TextAppearance.TungTung.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/ttColorPrimary</item>
    </style>

    <!-- Display Medium: Stat value numbers (20sp bold - e.g., Today: 5) -->
    <style name="TextAppearance.TungTung.DisplayMedium" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/ttColorPrimary</item>
    </style>

    <!-- ============================================
         SHAPE APPEARANCE STYLES
         ============================================ -->

    <!-- Shape for Cards -->
    <style name="ShapeAppearance.TungTung.Card" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">@dimen/card_radius</item>
    </style>

    <!-- Shape for Buttons -->
    <style name="ShapeAppearance.TungTung.Button" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">@dimen/button_radius</item>
    </style>

    <!-- Shape for Modal/Dialog -->
    <style name="ShapeAppearance.TungTung.Modal" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">@dimen/modal_radius</item>
    </style>

    <!-- Shape for Avatar (Circle) -->
    <style name="ShapeAppearance.TungTung.Circle" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">50%</item>
    </style>

    <!-- ============================================
         WIDGET STYLES (Cards)
         ============================================ -->

    <!-- Default Card Style -->
    <style name="Widget.TungTung.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">?attr/ttColorSurface</item>
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">@dimen/elevation_sm</item>
        <item name="strokeColor">?attr/ttColorBorder</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Card Highlight (Streak, Promo) -->
    <style name="Widget.TungTung.Card.Highlight" parent="Widget.TungTung.Card">
        <item name="cardBackgroundColor">?attr/ttColorPrimaryTint</item>
        <item name="strokeColor">?attr/ttColorPrimary</item>
        <item name="cardElevation">@dimen/elevation_md</item>
    </style>

    <!-- ============================================
         WIDGET STYLES (Buttons)
         ============================================ -->

    <!-- Primary Button -->
    <style name="Widget.TungTung.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">?attr/ttColorPrimary</item>
        <item name="cornerRadius">@dimen/button_radius</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Outlined Button -->
    <style name="Widget.TungTung.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/button_radius</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">?attr/ttColorPrimary</item>
        <item name="strokeColor">?attr/ttColorPrimary</item>
    </style>

    <!-- Secondary Button -->
    <style name="Widget.TungTung.Button.Secondary" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">@dimen/button_radius</item>
        <item name="android:textAllCaps">false</item>
    </style>

</resources>


