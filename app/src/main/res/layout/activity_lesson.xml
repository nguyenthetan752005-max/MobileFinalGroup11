<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/ttColorBackground"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/buttonBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:tint="?attr/ttColorTextPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textLessonTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/ttColorTextPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textLessonSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/ttColorTextSecondary"
                android:textSize="13sp" />
        </LinearLayout>

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSentenceCounter"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/ttColorPrimary"
            app:chipBackgroundColor="?attr/ttColorPrimaryTint" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipStatus"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressLesson"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:indicatorColor="?attr/ttColorPrimary"
        app:trackColor="?attr/ttColorBorder" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/ttColorSurface"
        app:tabIndicatorColor="?attr/ttColorPrimary"
        app:tabSelectedTextColor="?attr/ttColorPrimary"
        app:tabTextColor="?attr/ttColorTextSecondary" />

    <ProgressBar
        android:id="@+id/progressLessonLoad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/videoPlayerCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/ttColorSurface"
                app:cardCornerRadius="@dimen/card_radius"
                app:cardElevation="@dimen/elevation_sm"
                app:strokeColor="?attr/ttColorBorder"
                app:strokeWidth="1dp">

                <com.pierfrancescosoffritti.androidyoutubeplayer.core.player.views.YouTubePlayerView
                    android:id="@+id/youtubePlayerView"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    app:enableAutomaticInitialization="false" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/dictationContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="?attr/ttColorSurface"
                    app:cardCornerRadius="@dimen/card_radius"
                    app:cardElevation="@dimen/elevation_md"
                    app:strokeColor="?attr/ttColorBorder"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.floatingactionbutton.FloatingActionButton
                                android:id="@+id/buttonPlay"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/ic_play"
                                app:backgroundTint="?attr/ttColorPrimary"
                                app:fabCustomSize="52dp"
                                app:tint="@color/white"
                                app:elevation="@dimen/elevation_sm" />

                            <TextView
                                android:id="@+id/textPlaybackTime"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:fontFamily="monospace"
                                android:textColor="?attr/ttColorTextSecondary"
                                android:textStyle="bold" />

                            <ImageButton
                                android:id="@+id/buttonReplay"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:src="@drawable/ic_replay"
                                android:tint="?attr/ttColorTextSecondary" />
                        </LinearLayout>

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progressPlayback"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            app:indicatorColor="?attr/ttColorPrimary"
                            app:trackColor="?attr/ttColorBorder"
                            app:trackThickness="4dp"
                            app:trackCornerRadius="2dp" />

                        <TextView
                            android:id="@+id/textMediaSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:textColor="?attr/ttColorTextSecondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/textHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="?attr/ttColorPrimaryTint"
                    android:padding="14dp"
                    android:textColor="?attr/ttColorPrimary"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Type what you hear"
                    app:boxBackgroundColor="?attr/ttColorSurface">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputDictation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine|textCapSentences"
                        android:minLines="4" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonPrevious"
                        style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:text="&lt;"
                        android:textColor="?attr/ttColorPrimary"
                        android:visibility="gone"
                        app:cornerRadius="8dp"
                        app:strokeColor="?attr/ttColorPrimary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonCheck"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="@string/lesson_check"
                        android:textAllCaps="false"
                        app:backgroundTint="?attr/ttColorPrimary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonSkip"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/lesson_skip"
                        android:textAllCaps="false"
                        android:textColor="?attr/ttColorPrimary"
                        app:strokeColor="?attr/ttColorPrimary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonNext"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/lesson_next"
                        android:textAllCaps="false"
                        android:visibility="gone"
                        app:backgroundTint="@color/tt_success" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardFeedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="?attr/ttColorSurface"
                    app:cardCornerRadius="@dimen/card_radius"
                    app:cardElevation="@dimen/elevation_sm"
                    app:strokeColor="@color/tt_warning"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/textFeedbackTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textCorrectWords"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="?attr/ttColorPrimary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textNewHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/tt_success"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textMaskedWords"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/tt_error"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/transcriptContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView android:id="@+id/textTranscriptSentence" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="?attr/ttColorTextPrimary" android:textSize="18sp" android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton android:id="@+id/buttonTranscriptPrev" android:layout_width="40dp" android:layout_height="40dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_skip_prev" />
                    <ImageButton android:id="@+id/buttonTranscriptPlay" android:layout_width="52dp" android:layout_height="52dp" android:layout_marginStart="8dp" android:backgroundTint="?attr/ttColorPrimary" android:src="@drawable/ic_play" android:tint="@color/white" />
                    <ImageButton android:id="@+id/buttonTranscriptNext" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="8dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_skip_next" />
                    <TextView android:id="@+id/textTranscriptPlaybackTime" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:textColor="?attr/ttColorTextSecondary" android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressTranscript"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:indicatorColor="?attr/ttColorPrimary"
                    app:trackColor="?attr/ttColorBorder"
                    app:trackThickness="4dp"
                    app:trackCornerRadius="2dp" />

                <TextView
                    android:id="@+id/textTranscriptMediaSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="?attr/ttColorTextSecondary"
                    android:textSize="13sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerTranscript"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/speakingContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">


                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="?attr/ttColorSurface"
                    app:cardCornerRadius="@dimen/card_radius"
                    app:cardElevation="@dimen/elevation_md"
                    app:strokeColor="?attr/ttColorPrimary"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="24dp">

                        <TextView
                            android:id="@+id/textSpeakingReference"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:lineSpacingExtra="4dp"
                            android:textColor="?attr/ttColorTextPrimary"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <ImageButton
                    android:id="@+id/buttonSpeakingPlay"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="?attr/ttColorPrimaryTint"
                    android:src="@drawable/ic_play"
                    android:contentDescription="@string/lesson_play_sample"
                    android:tint="?attr/ttColorPrimary" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/buttonRecord"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:src="@drawable/ic_mic"
                    app:backgroundTint="@color/tt_warning"
                    app:fabCustomSize="80dp"
                    app:maxImageSize="40dp"
                    app:elevation="@dimen/elevation_md"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/textRecordingState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:textColor="?attr/ttColorTextSecondary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="?attr/ttColorSurfaceAlt"
                        app:cardCornerRadius="@dimen/card_radius"
                        app:cardElevation="@dimen/elevation_sm"
                        app:strokeColor="@color/tt_warning"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/speaking_best_attempt"
                                android:textColor="?attr/ttColorTextSecondary"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/textBestScore"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:textColor="@color/tt_warning"
                                    android:textStyle="bold" />

                                <ImageButton
                                    android:id="@+id/buttonPlayBestAudio"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:contentDescription="@string/lesson_play_best_audio"
                                    android:src="@drawable/ic_play"
                                    android:tint="@color/tt_warning"
                                    android:visibility="gone" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/textBestTranscript"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:textColor="?attr/ttColorTextSecondary"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:cardBackgroundColor="?attr/ttColorSurface"
                        app:cardCornerRadius="@dimen/card_radius"
                        app:cardElevation="@dimen/elevation_sm"
                        app:strokeColor="@color/tt_info"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/speaking_current_attempt"
                                android:textColor="?attr/ttColorTextSecondary"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/textCurrentScore"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:textColor="@color/tt_info"
                                    android:textStyle="bold" />

                                <ImageButton
                                    android:id="@+id/buttonPlayCurrentAudio"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:contentDescription="@string/lesson_play_current_audio"
                                    android:src="@drawable/ic_play"
                                    android:tint="@color/tt_info"
                                    android:visibility="gone" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/textCurrentTranscript"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:textColor="?attr/ttColorTextSecondary"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonSpeakingPrevious"
                        style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:text="@string/lesson_previous"
                        android:textAllCaps="false"
                        android:textColor="?attr/ttColorPrimary"
                        android:visibility="gone"
                        app:cornerRadius="8dp"
                        app:strokeColor="?attr/ttColorPrimary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonTryAgain"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="@string/lesson_try_again"
                        android:textAllCaps="false"
                        android:textColor="?attr/ttColorPrimary"
                        app:strokeColor="?attr/ttColorPrimary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonSpeakingNext"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/lesson_next"
                        android:textAllCaps="false"
                        app:backgroundTint="@color/tt_success" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/commentsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="?attr/ttColorSurface"
                app:cardCornerRadius="@dimen/card_radius"
                app:cardElevation="@dimen/elevation_sm"
                app:strokeColor="?attr/ttColorBorder"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView android:id="@+id/textCommentsTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_comments" android:textColor="?attr/ttColorTextPrimary" android:textSize="18sp" android:textStyle="bold" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/buttonWriteComment" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/label_write_comment" android:textAllCaps="false" android:textColor="?attr/ttColorPrimary" app:strokeColor="?attr/ttColorPrimary" />
                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerComments" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:nestedScrollingEnabled="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>

