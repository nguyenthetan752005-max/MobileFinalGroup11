<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/textAppearanceDialogSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.TungTung.BodyMedium"
            android:textColor="?attr/ttColorTextSecondary" />

        <RadioGroup
            android:id="@+id/groupPaletteOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginHorizontal="8dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/radioPaletteClassic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="14dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textAppearance="@style/TextAppearance.TungTung.BodyLarge"
                android:text="@string/palette_classic" />

            <RadioButton
                android:id="@+id/radioPaletteOcean"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="14dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textAppearance="@style/TextAppearance.TungTung.BodyLarge"
                android:text="@string/palette_ocean" />

            <RadioButton
                android:id="@+id/radioPaletteForest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="14dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textAppearance="@style/TextAppearance.TungTung.BodyLarge"
                android:text="@string/palette_forest" />

            <RadioButton
                android:id="@+id/radioPaletteSunset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="14dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textAppearance="@style/TextAppearance.TungTung.BodyLarge"
                android:text="@string/palette_sunset" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:textAlignment="center"
            android:text="@string/settings_preview_title"
            android:textColor="?attr/ttColorTextPrimary"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAppearancePreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp">

            <LinearLayout
                android:id="@+id/layoutAppearancePreviewRoot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="24dp">

                <TextView
                    android:id="@+id/textPreviewBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/settings_preview_badge"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textPreviewTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:textAlignment="center"
                    android:text="@string/settings_preview_title_text"
                    android:textAppearance="@style/TextAppearance.TungTung.TitleLarge" />

                <TextView
                    android:id="@+id/textPreviewBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textAlignment="center"
                    android:text="@string/settings_preview_body_text"
                    android:textAppearance="@style/TextAppearance.TungTung.BodySmall" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPreviewStat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/textPreviewStatLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/settings_preview_stat_label"
                            android:textAppearance="@style/TextAppearance.TungTung.LabelSmall" />

                        <TextView
                            android:id="@+id/textPreviewStatValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="@string/settings_preview_stat_value"
                            android:textAppearance="@style/TextAppearance.TungTung.TitleLarge" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonPreviewAction"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/settings_preview_action"
                            android:textAllCaps="false" />
                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
